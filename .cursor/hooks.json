{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node .cursor/hooks/e2e-pipeline-session-start.mjs"
      }
    ],
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/e2e-pipeline-mark-dirty.mjs"
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/e2e-pipeline-stop.mjs",
        "loop_limit": 3
      }
    ]
  }
}
