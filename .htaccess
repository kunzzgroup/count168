<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Keep existing files/directories untouched
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA fallback for routes like /login, /dashboard
  RewriteRule ^ index.html [L]
</IfModule>
