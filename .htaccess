# PHP 上传/执行限制（post_max_size、memory_limit 等）
#
# Hostinger 等环境若在此处使用 php_value，常会直接返回 HTTP 500。
# 请在 hPanel → Advanced → PHP Configuration（或 MultiPHP INI Editor）中设置：
#   post_max_size=64M, upload_max_filesize=64M, max_input_vars=5000,
#   max_input_time=300, max_execution_time=300, memory_limit=256M
#
# 若你的主机明确支持在 .htaccess 里写 php_value（Apache + mod_php），可取消下面整段注释：
# php_value post_max_size 64M
# php_value upload_max_filesize 64M
# php_value max_input_vars 5000
# php_value max_input_time 300
# php_value max_execution_time 300
# php_value memory_limit 256M

<IfModule mod_rewrite.c>
RewriteEngine On

# Canonical no-extension links for Process List.
RewriteRule ^processlist\.php$ /process-list [R=301,L]
RewriteRule ^games_process_list\.php$ /process-list [R=301,L]
RewriteRule ^bank_process_list\.php$ /bank-process-list [R=301,L]

# Canonical SPA entry URLs handled by PHP router (index.php).
RewriteRule ^login/?$ index.php [L,QSA]
RewriteRule ^dashboard/?$ index.php [L,QSA]
RewriteRule ^domain/?$ index.php [L,QSA]
RewriteRule ^announcement/?$ index.php [L,QSA]
RewriteRule ^account-list/?$ index.php [L,QSA]
RewriteRule ^add-account/?$ index.php [L,QSA]
RewriteRule ^process-list/?$ index.php [L,QSA]
RewriteRule ^games-process-list/?$ index.php [L,QSA]
RewriteRule ^bank-process-list/?$ index.php [L,QSA]
</IfModule>

