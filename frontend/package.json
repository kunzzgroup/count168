{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "description": "All React: src/+dist/ = admin SPA; login/ (src/+dist/) = login bundle at URL /login/. Run npm run build:all before deploy.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:login": "npm --prefix login run build",
    "build:all": "npm run build && npm run build:login",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "vite": "^8.0.9"
  }
}
